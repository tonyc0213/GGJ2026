  itemList:
  - key: 0
    item:
      dialogueListEng:
      - ...
      - I didn't do it.
      - That's what a killer would say.
      - I was arrested for suspected burglary.
      dialogueListCn:
      - ...
      - "\u6211\u5187\u505A\u904E!"
      - "\u5341\u8DB3\u5341\u4FC2\u6BBA\u4EBA\u72AF\u8B1B\u65E2\u91CE"
      - "\u6211\u53EA\u4FC2\u56E0\u70BA\u5077\u4EBA\u4FFE\u4EBA\u62C9\u5DE6!"
  - key: 1
    item:
      dialogueListEng:
      - ...
      - It wasn't me.
      - Right.
      - I swear.
      dialogueListCn:
      - ...
      - "\u5514\u4FC2\u6211\u554A!"
      - "\u660E\u65E2"
      - "\u6211\u767C\u8A93!"
  - key: 2
    item:
      dialogueListEng:
      - We found your DNA at the crime scene
      - ...
      - Now talk!
      dialogueListCn:
      - "\u6211\u5730\u55BA\u72AF\u7F6A\u73FE\u5834\u6435\u5230\u4F60\u65E2DNA"
      - ...
      - "\u5FEB\u5572\u5F9E\u5BE6\u62DB\u4F86!"
  - key: 3
    item:
      dialogueListEng:
      - So... Where were you last night.
      - I want a lawyer.
      - ...
      dialogueListCn:
      - "\u6240\u4EE5...\u4F60\u5C0B\u665A\u55BA\u908A\u5EA6?"
      - "\u6211\u8981\u6435\u5F8B\u5E2B!"
      - ...
